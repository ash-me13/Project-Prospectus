# ==============================================================================
# Prospectus SaaS Environment Variables
# Copy this file to .env.local to configure real external services.
# When unconfigured, Prospectus gracefully falls back to the in-memory MSOT seed store.
# ==============================================================================

# Supabase PostgreSQL & Auth Credentials
# Found in your Supabase project dashboard under Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
# Required for running administrative migrations and background notification crons
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Playwright Test Base URL
PLAYWRIGHT_BASE_URL=http://localhost:3000
